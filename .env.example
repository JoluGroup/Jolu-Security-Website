# Enquiry form (app/api/enquiry/route.ts). Server-side only — never prefix with NEXT_PUBLIC_.
# Nothing here is enabled by default: with no configuration the endpoint returns 503.

# ---------------------------------------------------------------------------
# Delivery mode (REQUIRED). Independent of NODE_ENV, so previews (which run production
# builds) behave exactly as configured.
#
#   live   Send through Resend. Needs RESEND_API_KEY, ENQUIRY_FROM and ENQUIRY_TO.
#          Having credentials without ENQUIRY_DELIVERY=live never sends anything.
#   test   Validate and answer 200 {ok:true, delivered:false, mode:"test"}; the form
#          says "Test mode: nothing was sent." Resend is NEVER contacted in this mode,
#          even if credentials are present. Use this on previews and local testing.
#          Upstash is optional here (an in-memory limiter is used if it is absent).
#   unset / anything else   Fails closed: 503 {ok:false, code:"not_configured"}.
#
# Recommended: previews = test, production = live.
ENQUIRY_DELIVERY=

# Resend (https://resend.com). ENQUIRY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=

# ---------------------------------------------------------------------------
# Upstash Redis REST — durable rate limiting. Required for live mode in production.
# Without it, live mode returns 503 not_configured. Outside production (and in test
# mode) an in-memory limiter is used; it is not shared across instances.
# If Redis is unreachable the endpoint FAILS CLOSED: 503 {ok:false, code:"unavailable"}.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits (all optional; invalid or out-of-range values fall back to the defaults).
#
# Both limits are FIXED-DURATION windows, not sliding windows: the first request creates
# a counter that expires exactly one window later, and later requests never extend it.
# A blocked client is therefore freed one window after its first request, however often
# it retries. A burst can straddle a window boundary (up to 2x the limit across two
# adjacent windows); the global cap bounds that.
#
# Per-client limit (only when a trusted client IP exists, see ENQUIRY_TRUSTED_PROXY).
# ENQUIRY_CLIENT_LIMIT=5                 # 1-1000
# ENQUIRY_CLIENT_WINDOW_SECONDS=600      # 60-86400
# Global limit across the whole site (always applied; the ONLY limit in shared mode).
# Requests refused by the per-client limit do not count toward it.
# ENQUIRY_GLOBAL_LIMIT=200               # 1-100000
# ENQUIRY_GLOBAL_WINDOW_SECONDS=3600     # 60-86400
#
# Refused requests get 429 {ok:false, code:"rate_limited"} with a Retry-After header
# (whole seconds until the window resets).

# ---------------------------------------------------------------------------
# Trusted client identity. DEFAULT: none. Forwarded headers (x-forwarded-for,
# x-real-ip, ...) are client-controlled unless a proxy you rely on overwrites them, so
# by default NO header is trusted: every visitor shares one identity and only the
# global limit applies. Enable a mode only AFTER the hosting provider is confirmed.
#
#   (unset) / none      Trust nothing. Shared identity, global limit only.
#   vercel              On Vercel only: uses x-vercel-forwarded-for, then x-real-ip
#                       (Vercel overwrites these with the real client IP).
#   forwarded-for:<N>   N trusted proxies each append to x-forwarded-for; the Nth
#                       entry from the right is the client. Entries to the left are
#                       client-supplied and ignored. N is 1-10.
# A missing, malformed or non-IP header falls back to the shared identity. IPv6
# addresses are grouped by /64. An unrecognised value is treated as "none".
# ENQUIRY_TRUSTED_PROXY=

# ---------------------------------------------------------------------------
# Request limits (fixed in code): JSON only, 16 KiB maximum. The body is read as a
# stream and rejected with 413 as soon as the limit is exceeded.
#
# Status codes: 200 ok | 400 invalid / bad JSON / honeypot | 403 cross-origin |
# 413 body too large | 415 not JSON | 429 rate limited (Retry-After) |
# 502 email provider failed | 503 not_configured or unavailable (Redis down).
# On any 4xx/5xx the form keeps the visitor's input and offers phone and WhatsApp.

# ---------------------------------------------------------------------------
# Automated tests (no dependencies, Node 22.18+ or 23.6+):   pnpm test
# They use a local fake of the Upstash REST API and a stubbed Resend call; they never
# contact real services. The checks below need real credentials and are manual.
#
# Manual checks against `next dev`, then repeat on a preview deployment:
# 1. Unset mode: leave ENQUIRY_DELIVERY unset (even with RESEND_* filled in).
#    Submit a valid form -> 503 {ok:false, code:"not_configured"}; input is kept.
# 2. Test mode: ENQUIRY_DELIVERY=test. Valid submit -> 200
#    {ok:true, delivered:false, mode:"test"}; UI shows "Test mode: nothing was sent."
#    Works on previews too, because it does not depend on NODE_ENV.
# 3. Invalid: bad email / phone "123" / no consent -> 400 {ok:false, code:"invalid"}.
# 4. Honeypot: curl -X POST <url>/api/enquiry -H 'content-type: application/json' \
#      -d '{"company_website":"x"}'  -> 400 {ok:false, code:"rejected"}.
# 5. Rate limit: set ENQUIRY_GLOBAL_LIMIT=3, send 4 requests -> the 4th returns 429 with
#    a Retry-After header. (Per-client limiting needs ENQUIRY_TRUSTED_PROXY.)
# 6. Real delivery (needs real Resend + Upstash credentials): ENQUIRY_DELIVERY=live.
#    Valid submit -> {ok:true, ref, state:"accepted"}. Confirm the email arrived at
#    ENQUIRY_TO; "accepted" only means Resend accepted it, not inbox delivery.
# 7. Cross-origin: send with -H 'origin: https://example.com' -> 403.
# 8. Redis outage (needs a real database): use a wrong UPSTASH_REDIS_REST_TOKEN in a
#    preview -> 503 {ok:false, code:"unavailable"}, and no email is sent.
