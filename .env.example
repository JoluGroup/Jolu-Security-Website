# Enquiry form (app/api/enquiry/route.ts). Server-side only — never prefix with NEXT_PUBLIC_.

# Resend (https://resend.com). ENQUIRY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=

# Upstash Redis REST — durable rate limiting. Required in production; without it the
# endpoint returns 503 not_configured. Development falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "test" to validate without sending. Ignored when NODE_ENV=production.
ENQUIRY_DELIVERY=

# ---------------------------------------------------------------------------
# Manual test steps (run against `next dev`, then repeat on a preview deployment)
#
# 1. Missing config: leave RESEND_* / ENQUIRY_* empty and ENQUIRY_DELIVERY unset.
#    Submit a valid form -> 503 {ok:false, code:"not_configured"}; the UI keeps
#    the input and offers phone/WhatsApp. In production also clear UPSTASH_* -> 503.
# 2. Test mode: ENQUIRY_DELIVERY=test. Submit a valid form -> 200
#    {ok:true, delivered:false, mode:"test"}; UI shows "Test mode: nothing was sent."
# 3. Invalid: submit with a bad email / phone "123" / no consent -> 400
#    {ok:false, code:"invalid", errors:{...}}; inline errors, input preserved.
# 4. Honeypot: curl -X POST localhost:3000/api/enquiry -H 'content-type: application/json' \
#      -d '{"company_website":"x"}'  -> 400 {ok:false, code:"rejected"}.
# 5. Rate limit: send 6 requests within 10 minutes from one IP -> 6th returns 429.
# 6. Real delivery: fill RESEND_API_KEY, ENQUIRY_FROM, ENQUIRY_TO (+ UPSTASH_* in prod).
#    Valid submit -> {ok:true, ref, state:"accepted"}. Confirm the email arrived at
#    ENQUIRY_TO; "accepted" only means Resend accepted it, not inbox delivery.
# 7. Cross-origin: send with -H 'origin: https://example.com' -> 403.
