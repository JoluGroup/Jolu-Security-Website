# Enquiry form (app/api/enquiry/route.ts). Server-side only — never prefix with NEXT_PUBLIC_.
# Nothing here is enabled by default: with no configuration the endpoint returns 503.

# ---------------------------------------------------------------------------
# Delivery mode (REQUIRED). Live and disabled do not depend on NODE_ENV. Test mode in a
# production build (which includes previews) additionally needs the opt-in below.
#
#   live   Send through Resend. Needs RESEND_API_KEY, ENQUIRY_FROM and ENQUIRY_TO.
#          Having credentials without ENQUIRY_DELIVERY=live never sends anything.
#   test   Validate and answer 200 {ok:true, delivered:false, mode:"test"}; the form
#          says "Test mode: nothing was sent." Resend is NEVER contacted in this mode,
#          even if credentials are present. Use this on previews and local testing.
#          Upstash is optional here (an in-memory limiter is used if it is absent).
#          In a production build (NODE_ENV=production, which INCLUDES preview deployments)
#          test mode discards real enquiries, so it is refused with 503 not_configured
#          unless ENQUIRY_ALLOW_PRODUCTION_TEST=true is also set (see below).
#   unset / anything else   Fails closed: 503 {ok:false, code:"not_configured"}.
#
# Recommended: previews = test (+ ENQUIRY_ALLOW_PRODUCTION_TEST=true), production = live.
# CONFIGURATION RISK: never set ENQUIRY_DELIVERY=test, or ENQUIRY_ALLOW_PRODUCTION_TEST=true,
# on the real production site. The form would accept enquiries but never email them.
ENQUIRY_DELIVERY=

# Opt-in that lets test mode run in a production build. Only the exact value "true"
# counts. It never enables sending: test mode contacts Resend under no circumstances,
# whatever credentials are present, and the flag has no effect on live mode.
# Leave it unset on the production site.
ENQUIRY_ALLOW_PRODUCTION_TEST=

# Resend (https://resend.com). ENQUIRY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=

# ---------------------------------------------------------------------------
# Upstash Redis REST — durable rate limiting. Required for live mode in production.
# Without it, live mode returns 503 not_configured. Outside production (and in test
# mode) an in-memory limiter is used; it is not shared across instances.
# If Redis is unreachable the endpoint FAILS CLOSED: 503 {ok:false, code:"unavailable"}.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits (all optional; invalid or out-of-range values fall back to the defaults).
#
# Both limits are FIXED-DURATION windows, not sliding windows: the first request creates
# a counter that expires exactly one window later, and later requests never extend it.
# A blocked client is therefore freed one window after its first request, however often
# it retries. A burst can straddle a window boundary (up to 2x the limit across two
# adjacent windows); the global cap bounds that.
#
# Per-client limit (only when a trusted client IP exists, see ENQUIRY_TRUSTED_PROXY).
# ENQUIRY_CLIENT_LIMIT=5                 # 1-1000
# ENQUIRY_CLIENT_WINDOW_SECONDS=600      # 60-86400
# Global limit across the whole site (always applied; the ONLY limit in shared mode).
# Requests refused by the per-client limit, and requests that fail validation, do not count toward it.
# ENQUIRY_GLOBAL_LIMIT=200               # 1-100000
# ENQUIRY_GLOBAL_WINDOW_SECONDS=3600     # 60-86400
#
# What counts toward the quota:
#   PER-CLIENT (trusted client identity only): every request that reaches the limiter, valid or not
#   (malformed JSON, validation errors, honeypot hits, oversized or aborted bodies).
#   GLOBAL: only requests that PASSED validation. Junk traffic no longer uses the site-wide
#   allowance, so it cannot lock real visitors out by itself. Every email send is still preceded by
#   exactly one global charge, so the cap on emails per window is unchanged.
# Requests refused before the limiter cost nothing: wrong content type (415), bad or oversized
# Content-Length (400/413), cross-origin (403) and not configured (503).
# In shared mode (the default) there is no per-client limit, so someone sending VALID-looking
# enquiries can still reach the global cap and lock the form until its window ends; phone and
# WhatsApp remain the fallback. See docs/enquiry/quota-exhaustion.md for options (a trusted proxy
# mode, or a Vercel Firewall rate-limit rule) and docs/enquiry/trusted-client-ip.md for the evidence.
#
# Global lockout: once the global cap is reached, requests are refused with 429 before
# either counter is touched, so a visitor who keeps retrying does not use up their own
# per-client quota and has a full allowance when the global window resets. (Cost: one extra
# read-only Redis round trip per request in trusted-client mode.)
#
# Refused requests get 429 {ok:false, code:"rate_limited"} with a Retry-After header
# (whole seconds until the window resets).

# ---------------------------------------------------------------------------
# Trusted client identity. DEFAULT: none. Forwarded headers (x-forwarded-for,
# x-real-ip, ...) are client-controlled unless a proxy you rely on overwrites them, so
# by default NO header is trusted: every visitor shares one identity and only the
# global limit applies. Enable a mode only AFTER the hosting provider is confirmed.
#
#   (unset) / none      Trust nothing. Shared identity, global limit only.
#   vercel              On Vercel only: uses x-vercel-forwarded-for, then x-real-ip
#                       (Vercel overwrites these with the real client IP).
#   forwarded-for:<N>   N trusted proxies each append to x-forwarded-for; the Nth
#                       entry from the right is the client. Entries to the left are
#                       client-supplied and ignored. N is 1-10.
# A missing, malformed or non-IP header falls back to the shared identity. IPv6
# addresses are grouped by /64. An unrecognised value is treated as "none".
# ENQUIRY_TRUSTED_PROXY=

# ---------------------------------------------------------------------------
# Duplicate-enquiry protection (live mode only; no extra variables, uses the Upstash settings
# above). Identical enquiries within 10 minutes send ONE email. "Identical" means the same
# normalised content: case, extra spaces and phone/email formatting are ignored; any real change
# to name, phone, email, service, county, town or details is a new enquiry and is never blocked.
# Redis holds only keyed hashes (HMAC with a key derived from UPSTASH_REDIS_REST_TOKEN), never
# visitor data. Rotating that token simply forgets the current duplicate window.
#
# Replies the visitor can get:
#   200 accepted            sent. A repeat of the same enquiry returns 200 with the SAME ref and
#                           "duplicate": true, and sends nothing.
#   409 in_progress         the same enquiry is being sent right now (a double-click, or a retry
#                           while the first request is still running). Nothing new is sent.
#   502 delivery_failed     the email provider refused the request (4xx). Nothing was sent, and
#                           the visitor can retry immediately.
#   202 delivery_uncertain  the outcome is unknown (timeout, network error, provider 5xx/408/409,
#                           or a 2xx with no message id). It MAY have been sent, so the form says
#                           so and never claims "nothing was sent". A retry within 10 minutes tries
#                           again with the SAME ref as the Idempotency-Key, so Resend can drop a
#                           second copy IF it honours the key for this endpoint (not verified yet);
#                           otherwise the team could receive a duplicate email. A duplicate email
#                           is deliberately preferred over a lost lead.
#   503 unavailable         Redis failed before sending: nothing was sent.
#   500 server_error        an unexpected error BEFORE any delivery attempt: nothing was sent. (An
#                           unexpected error after delivery began is reported as 202 delivery_uncertain
#                           with the ref, never as "nothing was sent".)
# Logs: delivery refusals and 5xx answers log the numeric provider status and, when it is on a fixed
# allowlist, a short provider error name (for example validation_error). Never the response body,
# visitor data, keys or addresses. Unexpected errors log only the error constructor name.
# The in-flight lock lasts 30 s. If a server instance dies mid-send it expires on its own, so a
# retry is not blocked for the whole window (the same duplicate-over-lost-lead trade-off applies).
#
# LOCK OWNERSHIP: each request stores a random owner token as the lock value, and the lock is released
# only by an atomic Lua script (EVAL inside /multi-exec) that deletes it if the value still equals the
# caller's token. A request that outlives its lock therefore cannot delete the lock of the request that
# took over. This needs Lua scripting (EVAL) to be available on the Upstash database. Recording the
# result is monotonic: "sent" is never overwritten or downgraded; "unsure" never replaces anything.
#
# THIS IS NOT EXACTLY-ONCE DELIVERY. The team can still receive two emails for one enquiry when:
#   1. Redis fails while recording the result after Resend accepted the message (the lock then
#      expires after 30 s and an identical retry is treated as new);
#   2. a request outlives its 30 s lock and another request sends in the meantime;
#   3. an uncertain attempt was in fact delivered and Resend does not honour the Idempotency-Key
#      (unverified);
#   4. Redis loses data (eviction or failover) inside the 10 minute window.
# No path drops an enquiry silently: whenever nothing is sent, the visitor is told so.
# Duplicates still count toward the rate limits above (the limiter runs first). Test mode never
# reaches this code and never contacts Resend.

# ---------------------------------------------------------------------------
# Request limits (fixed in code): JSON only, 16 KiB maximum. The body is read as a
# stream and rejected with 413 as soon as the limit is exceeded.
#
# Status codes: 200 ok | 400 invalid / bad JSON / honeypot | 403 cross-origin |
# 413 body too large | 415 not JSON | 429 rate limited (Retry-After) |
# 502 email provider refused | 202 delivery_uncertain | 409 in_progress | 503 not_configured or
# unavailable (Redis down).
# On any 4xx/5xx the form keeps the visitor's input and offers phone and WhatsApp.

# ---------------------------------------------------------------------------
# Automated tests (no dependencies, Node 22.18+ or 23.6+):   pnpm test
# They use a local fake of the Upstash REST API and a stubbed Resend call; they never
# contact real services. The checks below need real credentials and are manual.
#
# Manual checks against `next dev`, then repeat on a preview deployment:
# 1. Unset mode: leave ENQUIRY_DELIVERY unset (even with RESEND_* filled in).
#    Submit a valid form -> 503 {ok:false, code:"not_configured"}; input is kept.
# 2. Test mode: ENQUIRY_DELIVERY=test. Valid submit -> 200
#    {ok:true, delivered:false, mode:"test"}; UI shows "Test mode: nothing was sent."
#    On a preview or any production build also set ENQUIRY_ALLOW_PRODUCTION_TEST=true;
#    without it the endpoint returns 503 not_configured.
# 3. Invalid: bad email / phone "123" / no consent -> 400 {ok:false, code:"invalid"}.
# 4. Honeypot: curl -X POST <url>/api/enquiry -H 'content-type: application/json' \
#      -d '{"company_website":"x"}'  -> 400 {ok:false, code:"rejected"}.
# 5. Rate limit: set ENQUIRY_GLOBAL_LIMIT=3, send 4 requests -> the 4th returns 429 with
#    a Retry-After header. (Per-client limiting needs ENQUIRY_TRUSTED_PROXY.)
# 6. Real delivery (needs real Resend + Upstash credentials): ENQUIRY_DELIVERY=live.
#    Valid submit -> {ok:true, ref, state:"accepted"}. Confirm the email arrived at
#    ENQUIRY_TO; "accepted" only means Resend accepted it, not inbox delivery.
# 7. Cross-origin: send with -H 'origin: https://example.com' -> 403.
# 8. Redis outage (needs a real database): use a wrong UPSTASH_REDIS_REST_TOKEN in a
#    preview -> 503 {ok:false, code:"unavailable"}, and no email is sent.
